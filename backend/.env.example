# Backend environment variables for Render or local development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food-app?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
PORT=5000
NODE_ENV=production

# ImageKit credentials (optional if using image uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
